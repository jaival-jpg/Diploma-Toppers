{
  "functions": {
    "api/page.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/api/papers/:paperId/view", "destination": "/api/paper-file?action=view&paperId=:paperId" },
    { "source": "/api/papers/:paperId/download", "destination": "/api/paper-file?action=download&paperId=:paperId" },
    { "source": "/api/pdf-files/:fileId", "destination": "/api/paper-file?action=file&fileId=:fileId" },
    { "source": "/api/stats/downloads", "destination": "/api/paper-file?action=stats" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/api/page?route=/" },
    {
      "source": "/((?!assets/|index\\.html$|.*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|woff2?|ttf|map|json|txt|xml)$).*)",
      "destination": "/api/page?route=/$1"
    }
  ]
}
